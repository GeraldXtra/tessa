{
  "$schema": "./tokens.schema.json",
  "meta": {
    "version": 1,
    "source": "ZOEY_OS-spec.md §3.8 — authoritative for all colour values",
    "note": "SHARED between apps/console and apps/orb. Do not edit without owner approval. CSS and Python are GENERATED from this file — never hand-edit dist/."
  },

  "color": {
    "bg-void":       { "value": "#08080A",                  "comment": "page background" },
    "bg-ambient":    { "value": "#0D1524",                  "comment": "deep navy radial behind the sphere" },
    "panel":         { "value": "rgba(18,18,22,0.72)",      "comment": "floating panel fill" },
    "panel-border":  { "value": "rgba(255,255,255,0.06)",   "comment": "1px hairline" },

    "accent":        { "value": "#FF6B1A",                  "comment": "primary orange — labels, active day, buttons" },
    "accent-dim":    { "value": "#B84D12",                  "comment": "pressed / disabled accent" },

    "sphere-hot":    { "value": "#FF3B00",                  "comment": "particle core" },
    "sphere-cool":   { "value": "#FFA94D",                  "comment": "particle rim" },

    "status-active": { "value": "#22C55E",                  "comment": "the green Done figure" },
    "status-warn":   { "value": "#FFA94D",                  "comment": "alias of sphere-cool — adds no new hue" },
    "status-error":  { "value": "#FF3B00",                  "comment": "alias of sphere-hot — adds no new hue" },
    "status-idle":   { "value": "#6B6B72",                  "comment": "alias of text-muted" },

    "text":          { "value": "#E8E8EA" },
    "text-muted":    { "value": "#6B6B72" },

    "prov-human":    { "value": "transparent",              "comment": "provenance gutter — owner typed it. CONTRACT §6.2" },
    "prov-program":  { "value": "rgba(107,107,114,0.55)",   "comment": "provenance gutter — process stdout/stderr" },
    "prov-agent":    { "value": "rgba(255,107,26,0.75)",    "comment": "provenance gutter — model-proposed" },

    "theme-void":          { "value": "#000000", "comment": "ORB THEMES — pure black stage. NOT a replacement for bg-void, which stays #08080A for apps/console. The Orb overrides bg-void with this at runtime; see apps/orb/src/renderer/theme.ts." },

    "theme-cyan-core":     { "value": "#E8FBFF", "comment": "owner-supplied. contrast vs black 19.67:1" },
    "theme-cyan-body":     { "value": "#6FE3F5", "comment": "owner-supplied. 13.98:1 — this is --accent under cyan" },
    "theme-cyan-idle":     { "value": "#01ADC8", "comment": "derived at H188 to 56% of body's contrast: 7.81:1" },

    "theme-amber-core":    { "value": "#FEF7E9", "comment": "derived at H38 — the one theme with no owner-supplied pair. 19.70:1" },
    "theme-amber-body":    { "value": "#FFCB70", "comment": "14.03:1" },
    "theme-amber-idle":    { "value": "#DE8C00", "comment": "7.86:1" },

    "theme-violet-core":   { "value": "#A78BFA", "comment": "owner-supplied. 7.72:1 — the DIMMEST core of the five; blue carries only 0.0722 of luminance, so this hue cannot reach cyan's 19.67 and stay violet" },
    "theme-violet-body":   { "value": "#7C5CE0", "comment": "owner-supplied. 4.46:1" },
    "theme-violet-idle":   { "value": "#7345FF", "comment": "derived at H255, floored at 4.0:1 so it stays visible on black" },

    "theme-emerald-core":  { "value": "#6EE7B7", "comment": "owner-supplied. 13.78:1" },
    "theme-emerald-body":  { "value": "#2DB88A", "comment": "owner-supplied. 8.33:1" },
    "theme-emerald-idle":  { "value": "#00885A", "comment": "derived at H160. 4.67:1" },

    "theme-ember-core":    { "value": "#FF9E7A", "comment": "owner-supplied. 10.42:1. dE2000 19.0 from --status-error" },
    "theme-ember-body":    { "value": "#E2603C", "comment": "owner-supplied. 5.97:1. WARNING: dE2000 6.9 from --status-error #FF3B00, hue 13 vs 14 — measured, reported, and the owner's call. #FF9163 (H18, 9.48:1) separates to dE 15.8 if he wants it." },
    "theme-ember-idle":    { "value": "#CE2D00", "comment": "derived at H13. 4.00:1. dE2000 11.2 from --status-error" }
  },

  "font": {
    "mono": { "value": "\"JetBrains Mono\", ui-monospace, \"Cascadia Mono\", Consolas, monospace", "comment": "bundled as woff2 — not installed on the owner's machine" }
  },

  "fontSize": {
    "label": { "value": "10px", "comment": "uppercase tracked labels" },
    "sm":    { "value": "11px" },
    "base":  { "value": "13px", "comment": "1.250 major third scale, 13px base" },
    "md":    { "value": "16px" },
    "lg":    { "value": "20px" },
    "xl":    { "value": "25px" }
  },

  "lineHeight": {
    "tight": { "value": "1.2" },
    "base":  { "value": "1.5" }
  },

  "label": {
    "transform": { "value": "uppercase" },
    "tracking":  { "value": "0.14em" }
  },

  "space": {
    "1": { "value": "4px" },
    "2": { "value": "8px" },
    "3": { "value": "12px" },
    "4": { "value": "16px" },
    "5": { "value": "24px" },
    "6": { "value": "32px" },
    "7": { "value": "48px" }
  },

  "radius": {
    "panel": { "value": "12px" },
    "sm":    { "value": "6px" },
    "pill":  { "value": "999px" }
  },

  "layout": {
    "rail-w":        { "value": "48px" },
    "panel-left-w":  { "value": "240px" },
    "panel-right-w": { "value": "280px" },
    "transcript-w":  { "value": "320px" },
    "full-layout-min-width": {
      "value": "1600px",
      "comment": "CONTRACT §9.2 — rail+left+right+transcript = 888px of chrome. On the owner's 1366x768 display that leaves ~478px of centre stage. Below this breakpoint, panels MUST collapse to overlays/drawers."
    }
  },

  "motion": {
    "fast":   { "value": "120ms" },
    "base":   { "value": "200ms" },
    "slow":   { "value": "400ms" },
    "easing": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
  },

  "rules": {
    "noEmoji": true,
    "noIconSoup": true,
    "noBluePurpleGradients": true,
    "centreStageFloatsOverVoid": true,
    "comment": "CONTRACT §9.1 — standing style rules binding both surfaces."
  }
}
