{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": "../../..",
    "types": ["node", "vite/client"],
    "noEmitOnError": true
  },
  "include": ["./*.test.ts", "./*.test.tsx", "../src/renderer/env.d.ts"]
}
