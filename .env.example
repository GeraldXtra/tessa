# .env.example — VARIABLE NAMES ONLY. Never commit values.
#
# Copy to .env for local development. `.env` is gitignored.
#
# ── IMPORTANT ────────────────────────────────────────────────────────────────
# Production secrets do NOT live here. TESSA_CORE-spec §6 and CONTRACT §6 require
# API keys in the Windows Credential Manager (via `keyring`), not a plaintext
# .env. This file exists for local development toggles and for documenting which
# names the daemon looks for — putting a real key in it is a mistake the audit
# log's redaction cannot undo, because .env is read before anything is logged.
#
# The daemon's own auth token is NOT here either. It is generated per launch and
# written to %LOCALAPPDATA%\Tessa\runtime.json with a user-only ACL (CONTRACT §1).

# ── Model access ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Daemon ───────────────────────────────────────────────────────────────────
# Optional. The daemon prefers 47600 and walks upward when taken; surfaces
# discover the real port from runtime.json. Set only to pin it in development.
TESSA_PORT=
TESSA_DEV=

# Where the daemon writes its database, logs, and audit chain.
# Defaults to ./data. Must stay outside OneDrive.
TESSA_DATA_DIR=

# ── Budget caps (spec §6 — hard stop, not a warning) ─────────────────────────
TESSA_NIGHTLY_BUDGET_USD=
TESSA_NGN_PER_GB=

# ── Voice (Phase 2+) ─────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
PICOVOICE_ACCESS_KEY=

# ── Integrations (Phase 5+) ──────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
NTFY_TOPIC=
